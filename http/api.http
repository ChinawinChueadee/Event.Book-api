@base_url = http://localhost:5005
@userToken = {{userLogin.response.body.token}}
@adminToken = {{adminLogin.response.body.token}}

###POST Register
POST {{base_url}}/auth/register
Content-Type: application/json

{
    "email" : "chin@gmail.com",
    "username" : "chin",
    "password" : "123456",
    "confirmPassword" : "123456"
}

###POST Login
# @name userLogin
POST {{base_url}}/auth/login
Content-Type: application/json

{
    "email" : "chin@gmail.com",
    "password" : "123456"
}

### POST Logout
POST {{base_url}}/auth/logout
Authorization: Bearer {{userToken}}


### PATCH Update My Profile
PATCH {{base_url}}/users/me
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "username": "chin_new",
    "profileImage": "https://www.svgrepo.com/show/420364/avatar-male-man.svg"
}

###GET By ID
GET {{base_url}}/users/me
Authorization: Bearer {{userToken}}

### DELETE My Profile (ลบ event + booking ของตัวเองด้วย)
DELETE {{base_url}}/users/me
Authorization: Bearer {{userToken}}


###POST event
POST {{base_url}}/events
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "title": "Workshop Programing",
    "description": "Hands-on Node.js workshop",
    "category": "Tech",
    "status": "OPEN",
    "eventDate": "2026-08-25",
  "location": "Bangkok",
  "capacity": 20
}

###GET All event
GET {{base_url}}/events


###GET My event
GET {{base_url}}/host/me/events
Authorization: Bearer {{userToken}}


### GET Event By Id
GET {{base_url}}/events/3

### PATCH Update Event
PATCH {{base_url}}/events/4
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "eventImage": "https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?q=80&w=800&auto=format&fit=crop"

}

###DELETE event
DELETE {{base_url}}/events/2
Authorization: Bearer {{userToken}}


### POST Create Booking
POST {{base_url}}/bookings
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "eventId": 3
}

### GET My Bookings
GET {{base_url}}/bookings/me
Authorization: Bearer {{userToken}}

### GET Booking By Id
GET {{base_url}}/bookings/1
Authorization: Bearer {{userToken}}

### PATCH Update Booking (เจ้าของ event confirm / reject)
PATCH {{base_url}}/bookings/1
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "status": "CONFIRMED"
}

### PATCH Cancel Booking
PATCH {{base_url}}/bookings/1/cancel
Authorization: Bearer {{userToken}}

### GET Bookings of My Event
GET {{base_url}}/events/3/bookings
Authorization: Bearer {{userToken}}

### GET My Event Statistics
GET {{base_url}}/events/3/stats
Authorization: Bearer {{userToken}}

### Search by keyword (title / description / location)
GET {{base_url}}/events?search=Node

### Filter by category
GET {{base_url}}/events?category=Tech

### Filter by date (ทั้งวัน)
GET {{base_url}}/events?date=2026-08-25

### Filter by status + location
GET {{base_url}}/events?status=OPEN&location=Bangkok

### Filter by date range
GET {{base_url}}/events?startDate=2026-09-01&endDate=2026-12-31

### Combine multiple filters
GET {{base_url}}/events?search=Workshop&category=Tech&date=2026-08-25

### Pagination
GET {{base_url}}/events?page=1&limit=10


### ===== ADMIN =====

### POST Admin Login (จาก seed)
# @name adminLogin
POST {{base_url}}/auth/login
Content-Type: application/json

{
    "email" : "admin@gmail.com",
    "password" : "123456"
}

### GET All Bookings (filter: status, eventId, userId)
GET {{base_url}}/admin/bookings?status=PENDING&page=1&limit=20
Authorization: Bearer {{adminToken}}

### GET All Users (filter: role, search)
GET {{base_url}}/admin/users?search=chin&page=1&limit=20
Authorization: Bearer {{adminToken}}

### PATCH Admin closes any event
PATCH {{base_url}}/events/3
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "status": "CLOSED"
}
