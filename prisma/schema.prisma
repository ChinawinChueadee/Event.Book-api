generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String
  email        String    @unique
  password     String
  profileImage String?
  role         Role      @default(USER)
  createdAt    DateTime  @default(now()) @map("createAt")
  bookings     Booking[]
  events       Event[]
}

model Event {
  id         Int         @id @default(autoincrement())
  title       String
  description String?     @db.Text
  category   String
  status     EventStatus @default(OPEN)
  eventDate  DateTime
  location   String
  capacity   Int
  userId     Int
  createdAt  DateTime    @default(now()) @map("createAt")
  updatedAt  DateTime    @updatedAt
  eventImage String?
  bookings   Booking[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Event_userId_fkey")
}

model Booking {
  id        Int           @id @default(autoincrement())
  status    BookingStatus @default(PENDING)
  userId    Int
  eventId   Int
  bookedAt  DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId], map: "Booking_eventId_fkey")
}

enum Role {
  USER
  ADMIN
}

enum EventStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
